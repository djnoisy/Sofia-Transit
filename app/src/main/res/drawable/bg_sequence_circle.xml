<?xml version="1.0" encoding="utf-8"?>
<!-- The number of a stop along a line, in an outlined circle; filled in the
     primary colour for the stop the travel times are counted from (the
     owner, 27 Nov 2026) — touched, it becomes that stop (StopOnRouteAdapter). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary"/>
            <stroke android:width="?attr/lineDividerWidth" android:color="?attr/colorPrimary"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurface"/>
            <stroke android:width="?attr/lineDividerWidth" android:color="?attr/colorOutline"/>
        </shape>
    </item>
</selector>
