<?xml version="1.0" encoding="utf-8"?>
<!-- A section of the navigation bar: the active one on a background of its
     own (colorNavActive) — a rounded field behind icon and label, apart
     from the bar by its lightness (the owner, 9 Nov 2026; was a line above
     it). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp"
            android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorNavActive"/>
                <corners android:radius="16dp"/>
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
