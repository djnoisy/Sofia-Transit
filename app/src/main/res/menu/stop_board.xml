<?xml version="1.0" encoding="utf-8"?>
<!-- The virtual board's actions, in its top bar (StopArrivalsFragment):
     refresh, and add to or remove from the favourites (its title and icon
     follow the stop's state). TalkBack reads their titles. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:id="@+id/actionRefresh"
        android:icon="@drawable/ic_refresh"
        android:title="Обнови"
        app:showAsAction="always"/>
    <item android:id="@+id/actionFavorite"
        android:icon="@drawable/ic_star_outline"
        android:title="Добави в любими"
        app:showAsAction="always"/>
</menu>
