<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.1 and later draw the navigation bar's buttons dark on a light
     bar (windowLightNavigationBar): the bar takes the navigation bar's colour.
     A dark theme takes values-night's, which outranks this. -->
<resources>
    <color name="nav_bar">@color/nav_bar_bg</color>
</resources>
