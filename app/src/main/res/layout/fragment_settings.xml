<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Гласови съобщения"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:alpha="0.6"
            android:accessibilityHeading="true"
            android:paddingBottom="8dp"/>

        <TextView android:id="@+id/tvEngineLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Речева машина"
            android:textSize="18sp"/>

        <TextView android:id="@+id/tvEngineCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:alpha="0.7"
            android:paddingTop="4dp"/>

        <Button android:id="@+id/btnChooseEngine"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Избери речева машина"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Речевата машина обработва заявките една по една. Ако изберете машина, различна от тази на екранния четец, съобщенията по време на пътуване няма да бъдат прекъсвани от четеца."
            android:textSize="14sp"
            android:alpha="0.7"
            android:paddingTop="12dp"/>

        <Button android:id="@+id/btnTestSpeech"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Изпробвай гласа"
            style="@style/Widget.Material3.Button.TextButton"/>

    </LinearLayout>
</ScrollView>
