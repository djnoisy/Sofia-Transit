<?xml version="1.0" encoding="utf-8"?>
<!-- A stop's window, "Спирка" (StopBoardActivity; the owner, 26 Nov 2026): a
     window of its own, opened from anywhere in the app — no navigation bar;
     in the top bar the back arrow, the title, "Обнови" (on the board) and the
     favourites, and under them, on the bar's background, the stop's name and
     code; then its two tabs, "Табло с пристигания" — the arrivals,
     StopArrivalsFragment — and "Разписания" — the timetable of a line
     there, ScheduleFragment — then the tab's page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- The window's head: the top bar and, on its background, the stop's
         name and code, "Метростанция Ал. Малинов (код 0169)" — part of the
         title, said first (the owner, 26 Nov 2026; under the bar, it hung
         in nothing on the page's background). Wraps, not cut short. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorNavBar"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>

        <TextView android:id="@+id/tvStopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="14dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:accessibilityHeading="true"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- The two tabs, "Табло с пристигания" and "Разписания": each framed,
         the selected one filled (bg_stop_tab; the owner, 26 Nov 2026) and its
         name bold (ui/common/Tabs); no line under it. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="6dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabBackground="@drawable/bg_stop_tab"
        app:tabTextColor="?attr/colorOnSurface"
        app:tabSelectedTextColor="?attr/colorOnNavActive"
        app:tabIndicatorHeight="0dp"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
