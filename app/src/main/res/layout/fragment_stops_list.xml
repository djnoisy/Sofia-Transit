<?xml version="1.0" encoding="utf-8"?>
<!-- A line's stops along a direction (RouteStopsFragment), in the line's
     window — its title the line, "Автобус 111" (LineWindowActivity): the
     direction chosen from a drop-down list, as the line in a stop's
     timetable ("към Ж.К. ЛЮЛИН-1,2"; the owner, 27 Nov 2026), the count of
     its stops (the owner: "useful"), the stops. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">

    <Spinner android:id="@+id/spinnerDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp"
        android:popupBackground="@drawable/bg_popup_outlined"
        android:saveEnabled="false"
        android:visibility="gone"/>

    <TextView android:id="@+id/tvStopCount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="15sp" android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="8dp"/>

    <TextView android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textSize="17sp"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvStops"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="8dp"/>
</LinearLayout>
