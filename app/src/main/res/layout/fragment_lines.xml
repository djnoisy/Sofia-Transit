<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The title, "Линии", is in the top app bar (activity_main.xml). -->
    <!-- The vehicle kinds, two by two: the chosen one filled in the primary
         colour (it was not shown before — an outlined button does not draw
         "selected"), each with its vehicle's icon instead of an emoji; 16sp
         and room for large fonts. TalkBack hears them as tabs with the
         selected state (LinesFragment). -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp"
        android:paddingTop="12dp" android:paddingBottom="4dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBus"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="64dp"
                android:layout_marginEnd="8dp" android:paddingHorizontal="8dp" android:paddingVertical="8dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="Автобуси" android:textSize="16sp"
                android:textColor="@color/filter_fg"
                app:icon="@drawable/ic_vehicle_bus" app:iconGravity="textStart" app:iconPadding="8dp"
                app:iconSize="26dp" app:iconTint="@color/filter_fg"
                app:backgroundTint="@color/filter_bg"
                app:strokeColor="?attr/colorOutline" app:strokeWidth="?attr/lineDividerWidth"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTram"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="64dp"
                android:paddingHorizontal="8dp" android:paddingVertical="8dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="Трамваи" android:textSize="16sp"
                android:textColor="@color/filter_fg"
                app:icon="@drawable/ic_vehicle_tram" app:iconGravity="textStart" app:iconPadding="8dp"
                app:iconSize="26dp" app:iconTint="@color/filter_fg"
                app:backgroundTint="@color/filter_bg"
                app:strokeColor="?attr/colorOutline" app:strokeWidth="?attr/lineDividerWidth"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTrolley"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="64dp"
                android:layout_marginEnd="8dp" android:paddingHorizontal="8dp" android:paddingVertical="8dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="Тролеи" android:textSize="16sp"
                android:textColor="@color/filter_fg"
                app:icon="@drawable/ic_vehicle_trolley" app:iconGravity="textStart" app:iconPadding="8dp"
                app:iconSize="26dp" app:iconTint="@color/filter_fg"
                app:backgroundTint="@color/filter_bg"
                app:strokeColor="?attr/colorOutline" app:strokeWidth="?attr/lineDividerWidth"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMetro"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="64dp"
                android:paddingHorizontal="8dp" android:paddingVertical="8dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="Метро" android:textSize="16sp"
                android:textColor="@color/filter_fg"
                app:icon="@drawable/ic_vehicle_metro" app:iconGravity="textStart" app:iconPadding="8dp"
                app:iconSize="26dp" app:iconTint="@color/filter_fg"
                app:backgroundTint="@color/filter_bg"
                app:strokeColor="?attr/colorOutline" app:strokeWidth="?attr/lineDividerWidth"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tvRouteCount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingHorizontal="16dp" android:paddingVertical="6dp"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRoutes"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingBottom="8dp" android:clipToPadding="false"/>
</LinearLayout>