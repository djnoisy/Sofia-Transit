<?xml version="1.0" encoding="utf-8"?>
<!-- Спирки → "Любими": the favourite stops as cards; a word on how to add
     one while there are none. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="Няма любими спирки. Отворете виртуалното табло на спирка и изберете „Добави в любими“."
        android:textSize="17sp"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavorites"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>
</LinearLayout>
