<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">

    <TextView android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:accessibilityHeading="true"/>

    <TextView android:id="@+id/tvSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:alpha="0.7"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"/>

    <!-- 7-day date strip. Chips are laid out equally across the full width
         (each weight=1) so on a normal phone they read as fixed. The
         HorizontalScrollView is only a safety net for very narrow screens
         where 7 chips wouldn't otherwise fit. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout android:id="@+id/dayStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp"/>
    </HorizontalScrollView>

    <!-- Selected day, full date: "вторник, 20 юли 2026 г." -->
    <TextView android:id="@+id/tvSelectedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:accessibilityHeading="true"/>

    <ProgressBar android:id="@+id/pbLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:importantForAccessibility="no"/>

    <TextView android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSchedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
