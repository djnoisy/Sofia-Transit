<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">

    <!-- The stop's name, the whole width ("Обнови" is in the top bar now,
         and the caption over the list is gone: the owner, 9 Nov 2026). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView android:id="@+id/tvStopName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:accessibilityHeading="true"/>

        <ProgressBar android:id="@+id/pbLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            android:importantForAccessibility="no"/>

    </LinearLayout>


    <!-- Debug / empty state — small, capped height, scrollable -->
    <ScrollView
        android:id="@+id/svEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:visibility="gone">

        <TextView android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textIsSelectable="true"/>
    </ScrollView>

    <!-- Arrivals list — gets all remaining vertical space via weight=1 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvArrivals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>
</LinearLayout>
