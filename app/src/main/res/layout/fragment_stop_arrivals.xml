<?xml version="1.0" encoding="utf-8"?>
<!-- The board, the "Табло с пристигания" tab of a stop's window (StopArrivalsFragment): the
     stop's name is the window's, above (activity_stop_board.xml); while the
     arrivals load, a small indicator at the top right, over the list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="8dp">

        <!-- Debug / empty state — small, capped height, scrollable -->
        <ScrollView
            android:id="@+id/svEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:visibility="gone">

            <TextView android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textIsSelectable="true"/>
        </ScrollView>

        <!-- Arrivals list — gets all remaining vertical space via weight=1 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvArrivals"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/pbLoading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:visibility="gone"
        android:importantForAccessibility="no"/>
</FrameLayout>
