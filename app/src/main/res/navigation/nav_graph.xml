<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nearbyFragment">

    <!-- From the top app bar, on any screen (MainActivity). -->
    <action android:id="@+id/actionGlobalSettings"
        app:destination="@id/settingsFragment"
        app:launchSingleTop="true"/>

    <action android:id="@+id/actionGlobalDiagnostics"
        app:destination="@id/diagnosticsFragment"
        app:launchSingleTop="true"/>

    <!-- ── Nearby Stops ── -->
    <fragment android:id="@+id/nearbyFragment"
        android:name="bg.sofia.transit.ui.nearby.NearbyStopsFragment"
        android:label="Спирки"
        tools:layout="@layout/fragment_nearby_stops">

    </fragment>

    <fragment android:id="@+id/settingsFragment"
        android:name="bg.sofia.transit.ui.settings.SettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/fragment_settings"/>

    <fragment android:id="@+id/diagnosticsFragment"
        android:name="bg.sofia.transit.ui.diagnostics.DiagnosticsFragment"
        android:label="Диагностика"
        tools:layout="@layout/fragment_diagnostics"/>

    <!-- ── Lines ── -->
    <fragment android:id="@+id/linesFragment"
        android:name="bg.sofia.transit.ui.lines.LinesFragment"
        android:label="Линии"
        tools:layout="@layout/fragment_lines">

        <!-- A line: its window, its stops along a direction chosen in it
             (LineWindowActivity; the owner, 27 Nov 2026). -->
    </fragment>

    <!-- ── Journey ── -->
    <fragment android:id="@+id/journeyFragment"
        android:name="bg.sofia.transit.ui.journey.JourneyFragment"
        android:label="Пътуване"
        tools:layout="@layout/fragment_journey"/>

</navigation>