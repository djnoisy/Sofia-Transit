<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation bar icons and labels: the active section's on its background
     (colorOnNavActive), the others in onSurfaceVariant. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorOnNavActive"/>
    <item android:color="?attr/colorOnSurfaceVariant"/>
</selector>
