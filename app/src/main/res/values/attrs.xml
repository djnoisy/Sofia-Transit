<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Arrival times ("след 3 мин"), as each theme colours them. -->
    <attr name="colorArrivalTime" format="color"/>
    <!-- Hints in text fields: apart from text typed in (cyan in high contrast). -->
    <attr name="colorHintText" format="color"/>
    <!-- The active section of the navigation bar: its background, and its
         icon and label on it (the owner, 9 Nov 2026). -->
    <attr name="colorNavActive" format="color"/>
    <!-- The navigation bar's own background, set apart from the screen's. -->
    <attr name="colorNavBar" format="color"/>
    <attr name="colorOnNavActive" format="color"/>
    <!-- Width of dividers and card outlines: 1dp, 2dp in high contrast. -->
    <attr name="lineDividerWidth" format="dimension"/>
</resources>
